{
  "rewrites": [
    { "source": "/boleto", "destination": "/api/boleto" },
    { "source": "/boleto.png", "destination": "/api/boleto-img" }
  ],
  "functions": {
    "api/boleto-img.js": { "includeFiles": "api/_fuentes/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
